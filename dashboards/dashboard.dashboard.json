{
  "schema": 1,
  "title": "Operations overview",
  "source": {
    "kind": "file",
    "path": "exports/fct_orders.parquet"
  },
  "model": {
    "date": "order_date",
    "currency": "BRL",
    "unit": "one",
    "dimensions": [
      {
        "id": "customer_state",
        "label": "State",
        "column": "customer_state"
      },
      {
        "id": "order_status",
        "label": "Order status",
        "column": "order_status"
      },
      {
        "id": "is_late",
        "label": "Is late",
        "column": "is_late"
      }
    ],
    "measures": [
      {
        "id": "revenue",
        "label": "Revenue",
        "format": "money",
        "expr": {
          "sum": "payment_total"
        }
      },
      {
        "id": "orders",
        "label": "Orders",
        "format": "count",
        "expr": {
          "count": true
        }
      },
      {
        "id": "aov",
        "label": "Average order value",
        "format": "money",
        "expr": {
          "ratio": [
            "revenue",
            "orders"
          ]
        }
      },
      {
        "id": "delivered_orders",
        "label": "Delivered orders",
        "format": "count",
        "expr": {
          "sum": "delivered_flag"
        }
      },
      {
        "id": "late_orders",
        "label": "Late orders",
        "format": "count",
        "expr": {
          "sum": "late_flag"
        }
      },
      {
        "id": "late_rate",
        "label": "Late rate",
        "format": "percent",
        "expr": {
          "ratio": [
            "late_orders",
            "delivered_orders"
          ]
        },
        "good": "down"
      },
      {
        "id": "reviewed_orders",
        "label": "Reviewed orders",
        "format": "count",
        "expr": {
          "sum": "reviewed_flag"
        }
      },
      {
        "id": "low_score_orders",
        "label": "Low-score orders",
        "format": "count",
        "expr": {
          "sum": "low_score_flag"
        }
      },
      {
        "id": "low_score_rate",
        "label": "Low-score rate",
        "format": "percent",
        "expr": {
          "ratio": [
            "low_score_orders",
            "reviewed_orders"
          ]
        },
        "good": "down"
      },
      {
        "id": "avg_review",
        "label": "Average review score",
        "format": "number",
        "expr": {
          "avg": "latest_review_score"
        },
        "good": "up"
      }
    ]
  },
  "view": {
    "layout": "grid",
    "arrangement": "flow",
    "range": {
      "from": "2016-09-01",
      "to": "2018-10-31"
    }
  },
  "pages": [
    {
      "id": "overview",
      "title": "Overview",
      "widgets": [
        {
          "id": "w1",
          "kind": "kpi",
          "title": "Revenue",
          "measure": "revenue"
        },
        {
          "id": "w2",
          "kind": "kpi",
          "title": "Orders",
          "measure": "orders"
        },
        {
          "id": "w3",
          "kind": "kpi",
          "title": "Late rate",
          "measure": "late_rate"
        },
        {
          "id": "w4",
          "kind": "kpi",
          "title": "Average review score",
          "measure": "avg_review"
        },
        {
          "id": "w5",
          "kind": "trend",
          "title": "Monthly revenue",
          "measure": "revenue"
        },
        {
          "id": "w6",
          "kind": "breakdown",
          "title": "Late rate by state",
          "measure": "late_rate",
          "by": "customer_state",
          "chart": "bars"
        },
        {
          "id": "w7",
          "kind": "breakdown",
          "title": "Lateness and review score",
          "measure": "avg_review",
          "by": "is_late",
          "chart": "bars"
        },
        {
          "id": "w8",
          "kind": "table",
          "title": "State detail",
          "by": "customer_state",
          "measures": [
            "orders",
            "revenue",
            "late_rate",
            "avg_review"
          ]
        }
      ]
    }
  ]
}
