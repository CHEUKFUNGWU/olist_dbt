{
  "schema": 1,
  "title": "支付结构",
  "source": {
    "kind": "file",
    "path": "exports/payment_mix.parquet"
  },
  "model": {
    "date": "month_start",
    "currency": "BRL",
    "unit": "one",
    "dimensions": [
      {
        "id": "payment_type",
        "label": "支付方式",
        "column": "payment_type"
      }
    ],
    "measures": [
      {
        "id": "payment_value",
        "label": "支付金额",
        "format": "money",
        "expr": {
          "sum": "payment_value"
        }
      },
      {
        "id": "payments",
        "label": "支付笔数",
        "format": "count",
        "expr": {
          "sum": "payment_count"
        }
      },
      {
        "id": "installment_payments",
        "label": "分期支付笔数",
        "format": "count",
        "expr": {
          "sum": "installment_payments"
        }
      },
      {
        "id": "installment_share",
        "label": "分期占比",
        "format": "percent",
        "expr": {
          "ratio": [
            "installment_payments",
            "payments"
          ]
        }
      },
      {
        "id": "avg_installments",
        "label": "平均分期数",
        "format": "number",
        "expr": {
          "avg": "avg_installments"
        }
      }
    ]
  },
  "view": {
    "layout": "grid",
    "arrangement": "classic",
    "range": {
      "from": "2016-09-01",
      "to": "2018-10-31"
    }
  },
  "pages": [
    {
      "id": "mix",
      "title": "支付结构",
      "widgets": [
        {
          "id": "w1",
          "kind": "kpi",
          "title": "支付金额",
          "measure": "payment_value"
        },
        {
          "id": "w2",
          "kind": "kpi",
          "title": "分期占比",
          "measure": "installment_share"
        },
        {
          "id": "w3",
          "kind": "breakdown",
          "title": "各支付方式占比",
          "measure": "payment_value",
          "by": "payment_type",
          "chart": "donut"
        },
        {
          "id": "w4",
          "kind": "trend",
          "title": "分期占比走势",
          "measure": "installment_share"
        },
        {
          "id": "w5",
          "kind": "table",
          "title": "支付方式明细",
          "by": "payment_type",
          "measures": [
            "payment_value",
            "payments",
            "installment_share",
            "avg_installments"
          ]
        }
      ]
    }
  ]
}
