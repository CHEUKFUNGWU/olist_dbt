{
  "schema": 1,
  "id": "w2flbjuqp2m2sn7k545pgyxssj",
  "title": "Operations overview",
  "source": {
    "kind": "file",
    "path": "exports/fct_orders.parquet"
  },
  "model": {
    "date": "order_date",
    "currency": "BRL",
    "unit": "one",
    "dimensions": [
      {
        "id": "state",
        "label": "State",
        "column": "customer_state"
      },
      {
        "id": "outcome",
        "label": "Delivery outcome",
        "column": "lateness_bucket"
      }
    ],
    "measures": [
      {
        "id": "revenue",
        "label": "Revenue",
        "format": "money",
        "expr": {
          "sum": "payment_total"
        },
        "good": "up",
        "decimals": 0
      },
      {
        "id": "orders",
        "label": "Orders",
        "format": "count",
        "expr": {
          "count": true
        }
      },
      {
        "id": "aov",
        "label": "Average order value",
        "format": "money",
        "expr": {
          "ratio": [
            "revenue",
            "orders"
          ]
        },
        "decimals": 0
      },
      {
        "id": "delivered",
        "label": "Delivered orders",
        "format": "count",
        "expr": {
          "sum": "delivered_flag"
        }
      },
      {
        "id": "late",
        "label": "Late orders",
        "format": "count",
        "expr": {
          "sum": "late_flag"
        }
      },
      {
        "id": "late_rate",
        "label": "Late rate",
        "format": "percent",
        "expr": {
          "ratio": [
            "late",
            "delivered"
          ]
        },
        "good": "down",
        "decimals": 1
      },
      {
        "id": "avg_review",
        "label": "Average review score",
        "format": "number",
        "expr": {
          "avg": "latest_review_score"
        },
        "good": "up",
        "decimals": 2
      }
    ]
  },
  "view": {
    "layout": "grid",
    "arrangement": "classic",
    "range": {
      "from": "2017-01-01",
      "to": "2018-08-31"
    },
    "compare": "none",
    "date_filter": true
  },
  "pages": [
    {
      "id": "overview",
      "title": "Operations overview",
      "subtitle": "Revenue, delivery and reviews, January 2017 to August 2018",
      "widgets": [
        {
          "id": "w1",
          "kind": "kpi",
          "title": "Revenue",
          "measure": "revenue"
        },
        {
          "id": "w2",
          "kind": "kpi",
          "title": "Orders",
          "measure": "orders"
        },
        {
          "id": "w3",
          "kind": "kpi",
          "title": "Late rate",
          "measure": "late_rate",
          "subtitle": "Late delivered orders over delivered orders"
        },
        {
          "id": "w4",
          "kind": "kpi",
          "title": "Average review score",
          "measure": "avg_review"
        },
        {
          "id": "w5",
          "kind": "trend",
          "title": "Monthly revenue and average order value",
          "compare": "none",
          "measures": [
            "revenue",
            "aov"
          ],
          "subtitle": "Bars are revenue on the left axis; the line is average order value on the right",
          "granularity": "month",
          "series": [
            {
              "measure": "revenue",
              "axis": "left",
              "chart": "bar"
            },
            {
              "measure": "aov",
              "axis": "right",
              "chart": "line"
            }
          ]
        },
        {
          "id": "w6",
          "kind": "breakdown",
          "title": "Late rate by state",
          "measure": "late_rate",
          "by": "state",
          "chart": "bars",
          "subtitle": "States with at least 100 delivered orders",
          "where": [
            {
              "measure": "delivered",
              "op": "\u003e=",
              "value": 100
            }
          ]
        },
        {
          "id": "w7",
          "kind": "breakdown",
          "title": "Review score by delivery outcome",
          "measure": "avg_review",
          "by": "outcome",
          "chart": "bars",
          "subtitle": "Average review score for on time, late and never delivered orders"
        }
      ]
    }
  ]
}
