{
  "schema": 1,
  "title": "Seller ranking",
  "source": {
    "kind": "file",
    "path": "exports/seller_performance.parquet"
  },
  "model": {
    "date": "as_of_date",
    "currency": "BRL",
    "unit": "one",
    "dimensions": [
      {
        "id": "seller",
        "label": "Seller",
        "column": "seller_id"
      },
      {
        "id": "seller_state",
        "label": "Seller state",
        "column": "state"
      }
    ],
    "measures": [
      {
        "id": "sellers",
        "label": "Sellers",
        "format": "count",
        "expr": {
          "countDistinct": "seller_id"
        }
      },
      {
        "id": "orders",
        "label": "Orders",
        "format": "count",
        "expr": {
          "sum": "order_count"
        }
      },
      {
        "id": "revenue",
        "label": "Sales",
        "format": "money",
        "expr": {
          "sum": "item_revenue"
        }
      },
      {
        "id": "delivered",
        "label": "Delivered orders",
        "format": "count",
        "expr": {
          "sum": "delivered_orders"
        }
      },
      {
        "id": "late",
        "label": "Late orders",
        "format": "count",
        "expr": {
          "sum": "late_orders"
        }
      },
      {
        "id": "late_rate",
        "label": "Late rate",
        "format": "percent",
        "expr": {
          "ratio": [
            "late",
            "delivered"
          ]
        },
        "good": "down"
      },
      {
        "id": "cancelled",
        "label": "Cancelled orders",
        "format": "count",
        "expr": {
          "sum": "cancelled_orders"
        }
      },
      {
        "id": "cancel_rate",
        "label": "Cancellation rate",
        "format": "percent",
        "expr": {
          "ratio": [
            "cancelled",
            "orders"
          ]
        },
        "good": "down"
      }
    ]
  },
  "view": {
    "layout": "grid",
    "arrangement": "rail",
    "range": {
      "from": "2018-10-17",
      "to": "2018-10-17"
    }
  },
  "pages": [
    {
      "id": "sellers",
      "title": "Seller ranking",
      "widgets": [
        {
          "id": "w1",
          "kind": "kpi",
          "title": "Sellers",
          "measure": "sellers"
        },
        {
          "id": "w2",
          "kind": "kpi",
          "title": "Overall late rate",
          "measure": "late_rate"
        },
        {
          "id": "w3",
          "kind": "kpi",
          "title": "Overall cancellation rate",
          "measure": "cancel_rate"
        },
        {
          "id": "w4",
          "kind": "breakdown",
          "title": "Seller late rate by state",
          "measure": "late_rate",
          "by": "seller_state",
          "chart": "bars"
        },
        {
          "id": "w5",
          "kind": "table",
          "title": "Seller detail",
          "by": "seller",
          "measures": [
            "orders",
            "revenue",
            "late_rate",
            "cancel_rate"
          ]
        }
      ]
    }
  ]
}
