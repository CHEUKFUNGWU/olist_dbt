{
  "schema": 1,
  "title": "Payment mix",
  "source": {
    "kind": "file",
    "path": "exports/payment_mix.parquet"
  },
  "model": {
    "date": "month_start",
    "currency": "BRL",
    "unit": "one",
    "dimensions": [
      {
        "id": "payment_type",
        "label": "Payment method",
        "column": "payment_type"
      }
    ],
    "measures": [
      {
        "id": "payment_value",
        "label": "Payment value",
        "format": "money",
        "expr": {
          "sum": "payment_value"
        }
      },
      {
        "id": "payments",
        "label": "Payments",
        "format": "count",
        "expr": {
          "sum": "payment_count"
        }
      },
      {
        "id": "installment_payments",
        "label": "Installment payments",
        "format": "count",
        "expr": {
          "sum": "installment_payments"
        }
      },
      {
        "id": "installment_share",
        "label": "Installment share",
        "format": "percent",
        "expr": {
          "ratio": [
            "installment_payments",
            "payments"
          ]
        }
      },
      {
        "id": "avg_installments",
        "label": "Average installments",
        "format": "number",
        "expr": {
          "avg": "avg_installments"
        }
      }
    ]
  },
  "view": {
    "layout": "grid",
    "arrangement": "rail",
    "range": {
      "from": "2017-01-01",
      "to": "2018-08-31"
    }
  },
  "pages": [
    {
      "id": "mix",
      "title": "Payment mix",
      "widgets": [
        {
          "id": "w1",
          "kind": "kpi",
          "title": "Payment value",
          "measure": "payment_value"
        },
        {
          "id": "w2",
          "kind": "kpi",
          "title": "Installment share",
          "measure": "installment_share"
        },
        {
          "id": "w3",
          "kind": "breakdown",
          "title": "Payment method share",
          "measure": "payment_value",
          "by": "payment_type",
          "chart": "donut"
        },
        {
          "id": "w4",
          "kind": "trend",
          "title": "Installment share over time",
          "measure": "installment_share"
        },
        {
          "id": "w5",
          "kind": "table",
          "title": "Payment method detail",
          "by": "payment_type",
          "measures": [
            "payment_value",
            "payments",
            "installment_share",
            "avg_installments"
          ]
        }
      ]
    }
  ]
}
